---
layout: "base.njk"
---

{% set currentIndex = -1 %}
{% for nowItem in collections.now %}
  {% if nowItem.url == page.url %}
    {% set currentIndex = loop.index0 %}
  {% endif %}
{% endfor %}

{% set previous = null %}
{% set next = null %}
{% if currentIndex >= 0 %}
  {% if currentIndex > 0 %}
    {% set previous = collections.now[currentIndex - 1] %}
  {% endif %}
  {% if currentIndex < (collections.now | length) - 1 %}
    {% set next = collections.now[currentIndex + 1] %}
  {% endif %}
{% endif %}

{% set age = date | nowAge %}

<p class="now-meta">
  written {{ age }}{% if age != "today" %} ago{% endif %}{% if location %} from {{ location }}{% endif %}
</p>

<article class="now-content">

  {{ content | safe }}

</article>

<hr class="footer-hr">

<nav class="category-footer">
  {% if next %}
    <div><em>Next: <a href="{{ next.url }}">{{ next.data.title }}</a></em></div>
  {% endif %}

{% if previous %}
    <div><em>Previous: <a href="{{ previous.url }}">{{ previous.data.title }}</a></em></div>
  {% endif %}

  <div>Back to → <a href="{{ '/then/' | url }}"><strong>Now Archive</strong></a></div>
</nav>
